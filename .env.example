# Application Settings
APP_NAME="RedTeam Exercise Manager"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=5172
WORKERS=4

# Database
DATABASE_URL=sqlite:///./db/redteam.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@postgres:5432/redteam

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=*
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Initialization
SCHEMA_FILE=cli_schema.yaml
AUTO_POPULATE=true
